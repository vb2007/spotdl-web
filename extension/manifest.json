{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"description": "__MSG_extDescription__",
	"version": "1.0.2",
	"default_locale": "en",
	"homepage_url": "https://github.com/vb2007/spotdl-web",
	"browser_specific_settings": {
		"gecko": {
			"id": "spotdl-web@vb2007.hu",
			"update_url": "https://github.com/vb2007/spotdl-web/releases/download/extension-updates/updates.json",
			"strict_min_version": "153.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"icons": {
		"48": "icons/spotdl.svg",
		"96": "icons/spotdl.svg"
	},
	"permissions": ["storage"],
	"host_permissions": ["https://open.spotify.com/*", "https://spotdl.vb2007.hu/*"],
	"optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
	"background": {
		"scripts": ["background/background.js"],
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["https://open.spotify.com/*"],
			"js": ["content/selectors.js", "content/inject.js", "content/main.js"],
			"css": ["content/content.css"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_title": "__MSG_actionTitle__",
		"default_popup": "popup/popup.html",
		"default_icon": {
			"16": "icons/spotdl.svg",
			"32": "icons/spotdl.svg"
		}
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	}
}
