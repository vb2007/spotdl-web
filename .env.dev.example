# For local development on your own machine — see docs/LOCAL_DEV.md.
# Deploying to the Debian production host instead? Use .env.example and docs/DEPLOYMENT.md.
#
# Copy to .env and fill in real values. Never commit the real .env.

# --- Core infra ---
# Postgres itself still only runs on the Debian host (locked decision — never dockerized,
# never duplicated). Your local containers reach it over the LAN by its real address, not
# host.docker.internal (that only resolves correctly when the containers and Postgres share
# a host, which isn't the case here).
#
# v32: local dev uses its OWN database, spotdlwebtest, never production's. A shared database
# let local dev's worker-meta prune a real production ledger row (docs/GOTCHAS.md, v31/v32).
# docker-compose.override.yml marks every backend service SPOTDL_ENV=dev, and app/config.py
# refuses to boot them (migrate included) if this URL names the production database or can't
# be parsed. The owner creates spotdlwebtest; the `migrate` service builds its schema. See
# docs/LOCAL_DEV.md's "Dedicated dev database".
DATABASE_URL=postgresql+psycopg://spotdlweb:changeme@192.168.100.200:5432/spotdlwebtest
# Redis runs in a container on your own machine — no need to coordinate this with the
# deployed instance, each environment has its own independent Redis.
REDIS_PASSWORD=dev-redis-password
REDIS_URL=redis://:dev-redis-password@redis:6379/0

# --- Auth (v03) ---
# Test accounts only (register one on the upstream freely, see docs/LOCAL_DEV.md §4).
ALLOWED_EMAILS=you@example.com
UPSTREAM_AUTH_BASE_URL=https://api.vb2007.hu
SESSION_SECRET=changeme-generate-a-long-random-string

# --- Multi-user (v17) ---
# Required, and MUST also appear in ALLOWED_EMAILS above -- the app fails to start
# otherwise. A test account, never the real production ADMIN_EMAIL: the dev database is
# separate, so the dev admin is just whichever test identity should operate it. Add a second
# address to ALLOWED_EMAILS for a non-admin identity to test cross-user scoping against.
ADMIN_EMAIL=you@example.com

# --- Frontend (v09) ---
# v12: local dev is same-origin too now (Vite's dev-server /api proxy, see
# frontend/vite.config.ts) — the browser calls the API via a plain relative /api/... fetch
# against whichever loopback host/port the page was loaded from, so this CORS allowlist is a
# fallback rather than the real enforcement boundary. Covers both loopback hostnames anyway
# (localhost and 127.0.0.1 are different origins to a browser even though they're the same
# machine) for anyone bypassing the proxy.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- spotdl / download behavior ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DOWNLOAD_OUTPUT_DIR=/downloads
DEFAULT_FORMAT=mp3
DEFAULT_BITRATE=320k
COOKIE_FILE=

# --- Retry engine (v06) ---
# Shortening this is one of the main reasons to test locally: a 5-step ladder that takes
# days for real testing can run in well under a minute here.
LADDER_SECONDS=5,10,15,20,30

# --- Durability (v12) ---
# Shortened for local testing (see .env.example's comment) -- 300s instead of the
# production default's 1800s, so the stale-track reclaim sweep can actually be observed
# within a normal testing session. Not lower: it must stay above a real download (10-60s+,
# more for a long track), or the sweep reclaims a track mid-download and its message is
# delivered twice (v34.2; 20s did exactly that).
STALE_TRACK_AFTER_SECONDS=300

# --- Pacing hook, off by default (consumed by download_track as of v15) ---
# PACING_MAX_SEC=0 means off -- no sleep at all, not sleep(0). MIN must not exceed MAX
# (rejected at startup). Raising this means also raising STALE_TRACK_AFTER_SECONDS above
# it: pacing lengthens how long a dispatched batch's tail sits QUEUED, and beat's
# stale-track sweep can't tell "paced" from "stuck". (Local dev shortens
# STALE_TRACK_AFTER_SECONDS to 300s above -- raise it too before testing pacing here.)
PACING_MIN_SEC=0
PACING_MAX_SEC=0

# --- YouTube player client selection (v31.1) ---
# See .env.example's own comment -- same default, nothing dev-specific about this one.
YOUTUBE_PLAYER_CLIENTS=android,web,mweb

# --- Proxy rotation (v07) ---
# Copy proxies.txt.example to ./proxies.txt at the project root to test rotation locally.
PROXY_FILE=/app/proxies.txt

# --- Matrix alerts (v36, optional) ---
# See .env.example. Off when unset. Dev messages are labelled "spotdl-web (dev)" in the
# shared room; use them only for testing the alerts themselves.
# MATRIX_HOMESERVER_URL=https://matrix.example.org
# MATRIX_ACCESS_TOKEN=
# MATRIX_ROOM_ID=!roomid:example.org

# --- Cloudflare Tunnel (v12) ---
# Irrelevant locally — cloudflared stays behind the `tunnel` compose profile and is never
# started for local dev.
CLOUDFLARE_TUNNEL_TOKEN=
