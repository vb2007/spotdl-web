# For local development on your own machine — see docs/LOCAL_DEV.md.
# Deploying to the Debian production host instead? Use .env.example and docs/DEPLOYMENT.md.
#
# Copy to .env and fill in real values. Never commit the real .env.

# --- Core infra ---
# Postgres itself still only runs on the Debian host (locked decision — never dockerized,
# never duplicated). Your local containers reach it over the LAN by its real address, not
# host.docker.internal (that only resolves correctly when the containers and Postgres share
# a host, which isn't the case here). Same role/database the Debian host uses — no separate
# dev database for now, there's no real data yet worth protecting from it (see
# docs/LOCAL_DEV.md for when to switch to a dedicated one).
DATABASE_URL=postgresql+psycopg://spotdl_web:changeme@192.168.100.200:5432/spotdl_web
# Redis runs in a container on your own machine — no need to coordinate this with the
# deployed instance, each environment has its own independent Redis.
REDIS_PASSWORD=dev-redis-password
REDIS_URL=redis://:dev-redis-password@redis:6379/0

# --- Auth (v03) ---
# Your own account is enough for local testing.
ALLOWED_EMAILS=you@example.com
UPSTREAM_AUTH_BASE_URL=https://api.vb2007.hu
SESSION_SECRET=changeme-generate-a-long-random-string

# --- spotdl / download behavior ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DOWNLOAD_OUTPUT_DIR=/downloads
DEFAULT_FORMAT=mp3
DEFAULT_BITRATE=320k
COOKIE_FILE=

# --- Retry engine (v06) ---
# Shortening this is one of the main reasons to test locally: a 5-step ladder that takes
# days for real testing can run in well under a minute here.
LADDER_SECONDS=5,10,15,20,30

# --- Pacing hook (v07), off by default ---
PACING_MIN_SEC=0
PACING_MAX_SEC=0

# --- Cloudflare Tunnel (v12) ---
# Irrelevant locally — cloudflared stays behind the `tunnel` compose profile and is never
# started for local dev.
CLOUDFLARE_TUNNEL_TOKEN=
