/.claude
/.idea

# machine-specific graphify state, auto-regenerated by the interpreter guard
/graphify-out/.graphify_python
/graphify-out/.graphify_root

# env
.env
!.env.example
# v50: an agent slot's generated env (scripts/agent_stack.sh) and its generated PG_PORT overlay
/.env.agent
/.env.agent.*
/.agent-stack/
# v50: a slot's e2e identities (also covered by frontend/.gitignore's `.env.*`)
/frontend/e2e/.env.e2e.s*

# local dev: bind-mounted download output (see docker-compose.override.yml)
/downloads/

# local dev: throwaway test library for v28's sort & move -- never the real ~120k-track
# directory (see docker-compose.override.yml)
/test-library/

# proxy pool (v07): plain-file config, never commit real proxy credentials
/proxies.txt
!proxies.txt.example

# Postgres backups (v21, scripts/pg_backup.sh): default location is now inside the deploy
# checkout itself (REPO_ROOT/backups). CRITICAL that this stays gitignored, exactly like
# .env/proxies.txt above -- publish-deploy.yml's deploy job runs `git clean -fd` on every
# automated deploy, which deletes any untracked file NOT covered by this file. Losing this
# line would mean every real backup taken between one deploy and the next gets silently
# wiped by the very next deploy.
/backups/

# Durable last-known-good deploy (v33, publish-deploy.yml): the tag + commit a failed deploy
# rolls back to. Same reason as /backups/ above -- the deploy job's `git clean -fd` deletes any
# untracked file not covered here, and losing it would silently fall back to .env's IMAGE_TAG,
# which can be a throwaway manual-* dispatch tag.
/.last-good
/.last-good.tmp

# v37 e2e output (also in frontend/.gitignore). Repeated here because graphify reads only
# the repo-root .gitignore, and it indexed Playwright's reports, traces and saved sessions.
/frontend/playwright-report/
/frontend/test-results/
/frontend/e2e/.auth/
# v46: Paraglide's compiled messages (also in frontend/.gitignore), generated code graphify
# would otherwise index (2,000+ nodes) for the same reason.
/frontend/src/lib/paraglide/

# backend
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/build/
backend/.venv/
backend/.pytest_cache/
# pytest-html/pytest-excel/junit-xml output (backend-tests.yml's `report` extra)
backend/test-reports/