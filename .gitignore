/.claude
/.idea

# machine-specific graphify state, auto-regenerated by the interpreter guard
/graphify-out/.graphify_python
/graphify-out/.graphify_root

# env
.env
!.env.example

# local dev: bind-mounted download output (see docker-compose.override.yml)
/downloads/

# local dev: throwaway test library for v28's sort & move -- never the real ~120k-track
# directory (see docker-compose.override.yml)
/test-library/

# proxy pool (v07): plain-file config, never commit real proxy credentials
/proxies.txt
!proxies.txt.example

# Postgres backups (v21, scripts/pg_backup.sh): default location is now inside the deploy
# checkout itself (REPO_ROOT/backups). CRITICAL that this stays gitignored, exactly like
# .env/proxies.txt above -- publish-deploy.yml's deploy job runs `git clean -fd` on every
# automated deploy, which deletes any untracked file NOT covered by this file. Losing this
# line would mean every real backup taken between one deploy and the next gets silently
# wiped by the very next deploy.
/backups/

# backend
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/build/
backend/.venv/
backend/.pytest_cache/
# pytest-html/pytest-excel/junit-xml output (backend-tests.yml's `report` extra)
backend/test-reports/