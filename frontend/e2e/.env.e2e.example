# v37 e2e suite: copy to `.env.e2e` (gitignored) and fill in.
#
# Two TEST identities that log in through the real upstream (`UPSTREAM_AUTH_BASE_URL`), both in
# the dev `.env`'s ALLOWED_EMAILS. The admin one must be the dev ADMIN_EMAIL, the other must
# not be. Never the owner's real account. Register fresh ones freely
# (docs/LOCAL_DEV.md §4: `POST /auth/register`, plain alphanumeric username).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Optional. The web origin of the local stack (default http://localhost:5173, the dev `web`).
# E2E_BASE_URL=

# `@network` spec only (`npm run test:e2e:network`): a Spotify track URL that is NOT yet in the
# dev ledger. The spec refuses one that is, since it would dedup instead of downloading, and a
# passing run puts it there, so pick a fresh one each time.
# E2E_NETWORK_TRACK_URL=
