# Copy to .env (local dev) and fill in real values. Never commit the real .env — baked
# into the static build at build time, so this must exist before `npm run dev` or
# `npm run build` / `docker compose build web` runs.

# Base URL the browser calls for every backend API/SSE request. Local dev matches
# docker-compose.yml's api port mapping (127.0.0.1:8000:8000). Production must point at
# whatever origin the API is actually reachable on once v12 wires the real Cloudflare
# Tunnel ingress — this and the backend's FRONTEND_ORIGIN (.env.example at the repo root)
# describe the same two-origin boundary from each side.
PUBLIC_API_BASE_URL=http://localhost:8000
