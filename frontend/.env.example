# Copy to .env (local dev) and fill in real values if you need to override the default.
# Baked into the static build at build time.

# Base URL the browser calls for every backend API/SSE request. Leave empty (the
# default, matching frontend/Dockerfile's ARG default) for same-origin: both production
# (nginx's /api/ proxy inside the `web` container, see frontend/nginx.conf) and local dev
# (Vite's dev-server /api proxy, see vite.config.ts) serve the API through the same
# origin the page itself was loaded from — no CORS, no cross-origin cookie concerns.
# Only set this to an absolute URL (e.g. http://localhost:8000) if you need to point Vite's
# dev server directly at the api container's published port, bypassing the proxy.
PUBLIC_API_BASE_URL=
