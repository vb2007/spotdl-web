# For the Debian production/deployment host — see docs/DEPLOYMENT.md.
# Doing local development on your own machine instead? Use .env.dev.example and
# docs/LOCAL_DEV.md — different DATABASE_URL host, separate disposable database.
#
# Copy to .env and fill in real values. Never commit the real .env.

# --- Core infra ---
# Postgres runs on the Debian host, not in Docker. Containers reach it via
# host.docker.internal (see docker-compose.yml extra_hosts).
DATABASE_URL=postgresql+psycopg://spotdl_web:changeme@host.docker.internal:5432/spotdl_web
# Password below is also passed to the redis container as --requirepass.
REDIS_PASSWORD=changeme-redis-password
REDIS_URL=redis://:changeme-redis-password@redis:6379/0

# --- Auth (v03) ---
# Comma-separated list of upstream vb2007.hu-api emails allowed into spotdl-web.
ALLOWED_EMAILS=you@example.com
UPSTREAM_AUTH_BASE_URL=https://api.vb2007.hu
# Random secret used to sign spotdl-web's own session cookie.
SESSION_SECRET=changeme-generate-a-long-random-string

# --- spotdl / download behavior ---
# Optional: spotdl ships default public Spotify app credentials, only override
# if you have your own Spotify Developer app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DOWNLOAD_OUTPUT_DIR=/downloads
DEFAULT_FORMAT=mp3
DEFAULT_BITRATE=320k
# Optional: path (inside the worker container) to a cookies.txt for yt-dlp.
COOKIE_FILE=

# --- Retry engine (v06) ---
# Comma-separated seconds for the per-track backoff ladder. Shorten for testing.
LADDER_SECONDS=900,3600,14400,43200,86400

# --- Pacing hook (v07), off by default ---
PACING_MIN_SEC=0
PACING_MAX_SEC=0

# --- Proxy rotation (v07) ---
# Path (inside worker-meta) to a plain-text proxy list, one URL per line. See
# proxies.txt.example. UI management deferred to v13.
PROXY_FILE=/app/proxies.txt

# --- Cloudflare Tunnel (v12) ---
CLOUDFLARE_TUNNEL_TOKEN=
