# For the Debian production/deployment host — see docs/DEPLOYMENT.md.
# Doing local development on your own machine instead? Use .env.dev.example and
# docs/LOCAL_DEV.md — different DATABASE_URL host, separate disposable database.
#
# Copy to .env and fill in real values. Never commit the real .env.

# --- Core infra ---
# Postgres runs on the Debian host, not in Docker. Containers reach it via
# host.docker.internal (see docker-compose.yml extra_hosts).
DATABASE_URL=postgresql+psycopg://spotdl_web:changeme@host.docker.internal:5432/spotdl_web
# Password below is also passed to the redis container as --requirepass.
REDIS_PASSWORD=changeme-redis-password
REDIS_URL=redis://:changeme-redis-password@redis:6379/0

# --- Auth (v03) ---
# Comma-separated list of upstream vb2007.hu-api emails allowed into spotdl-web.
ALLOWED_EMAILS=you@example.com
UPSTREAM_AUTH_BASE_URL=https://api.vb2007.hu
# Random secret used to sign spotdl-web's own session cookie.
SESSION_SECRET=changeme-generate-a-long-random-string

# --- Frontend (v09) ---
# v12: production is same-origin (nginx's /api/ proxy inside the `web` container, see
# frontend/nginx.conf) — the browser never makes a cross-origin request to the API at all,
# so this CORS allowlist is a fallback, not the real enforcement boundary (SameSite=Lax on
# the session cookie is). Still worth setting correctly for anyone bypassing the proxy.
FRONTEND_ORIGINS=https://spotdl.vb2007.hu

# --- spotdl / download behavior ---
# Optional: spotdl ships default public Spotify app credentials, only override
# if you have your own Spotify Developer app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DOWNLOAD_OUTPUT_DIR=/downloads
DEFAULT_FORMAT=mp3
DEFAULT_BITRATE=320k
# Optional: path (inside the worker container) to a cookies.txt for yt-dlp.
COOKIE_FILE=

# --- Downloads storage (v12, production only) ---
# A real directory ON THE HOST (not in-container — that's DOWNLOAD_OUTPUT_DIR above),
# bind-mounted over worker-dl/worker-meta's /downloads by docker-compose.prod.yml, so
# downloaded files are directly browsable/backup-able and survive `docker compose down -v`
# (the base file's named volume would not). Not read by anything if you're only running
# `docker compose up` without the -f docker-compose.prod.yml overlay (local dev). MUST be
# populated with the existing named volume's contents before the first prod boot against
# this path — see docs/DEPLOYMENT.md's migration step; reconcile_disk() refuses to prune
# the dedup ledger if this looks missing/empty specifically to catch a skipped migration.
DOWNLOADS_DIR=/srv/spotdl-web/downloads

# --- Retry engine (v06) ---
# Comma-separated seconds for the per-track backoff ladder. Shorten for testing.
LADDER_SECONDS=900,3600,14400,43200,86400

# --- Durability (v12) ---
# How long a track can sit in DOWNLOADING/QUEUED before beat's stale-track reclaim sweep
# (app/tasks/beat.py) resets it back to WAITING -- the DB-level safety net for a message
# lost across a crash/kill that Celery's own task_acks_late redelivery didn't catch.
# Shorten for testing (verifying this by waiting out the real 1800s is impractical).
STALE_TRACK_AFTER_SECONDS=1800

# --- Pacing hook (v07), off by default ---
PACING_MIN_SEC=0
PACING_MAX_SEC=0

# --- Proxy rotation (v07) ---
# Path (inside worker-meta) to a plain-text proxy list, one URL per line. See
# proxies.txt.example. UI management deferred to v13.
PROXY_FILE=/app/proxies.txt

# --- Cloudflare Tunnel (v12) ---
CLOUDFLARE_TUNNEL_TOKEN=
