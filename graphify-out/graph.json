    {
      "label": "Direct-First Proxy Escalation Strategy",
      "file_type": "rationale",
      "source_file": "plan/00-master-plan.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Attempt 1 is always direct; only after waiting out the ladder delay does the next attempt use a proxy, so the proxy switch reads as normal retry behavior rather than an evasion burst.",
      "id": "plan_00_master_plan_proxy_escalation_strategy",
      "community": 5,
      "norm_label": "direct-first proxy escalation strategy"
    },
    {
      "label": "Celery ETA/Countdown Is Unsafe For Backoff",
      "file_type": "rationale",
      "source_file": "plan/00-master-plan.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "With the Redis broker, ETA-scheduled tasks are held in worker memory until due; a restart during a long wait silently drops or duplicates it. Postgres tracks.scheduled_at must be the sole source of truth so the schedule survives any restart.",
      "id": "plan_00_master_plan_celery_eta_unsafe_rationale",
      "community": 3,
      "norm_label": "celery eta/countdown is unsafe for backoff"
    },
