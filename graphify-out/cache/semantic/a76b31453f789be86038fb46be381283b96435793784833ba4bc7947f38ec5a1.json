{"nodes": [{"id": "plan_00_master_plan_overview", "label": "Master Development Plan", "file_type": "document", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_track_state_machine", "label": "Track State Machine", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_per_track_retry_ladder", "label": "Per-Track Retry Ladder", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_global_circuit_breaker", "label": "Global Circuit Breaker", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_proxy_escalation_strategy", "label": "Direct-First Proxy Escalation Strategy", "file_type": "rationale", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attempt 1 is always direct; only after waiting out the ladder delay does the next attempt use a proxy, so the proxy switch reads as normal retry behavior rather than an evasion burst."}, {"id": "plan_00_master_plan_celery_eta_unsafe_rationale", "label": "Celery ETA/Countdown Is Unsafe For Backoff", "file_type": "rationale", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With the Redis broker, ETA-scheduled tasks are held in worker memory until due; a restart during a long wait silently drops or duplicates it. Postgres tracks.scheduled_at must be the sole source of truth so the schedule survives any restart."}, {"id": "plan_00_master_plan_scheduled_at_source_of_truth", "label": "tracks.scheduled_at as Source of Truth", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_dispatch_due_tracks", "label": "dispatch_due_tracks Celery Beat Task", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_auth_server_to_server_pattern", "label": "Server-to-Server Login Pattern", "file_type": "rationale", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upstream Set-Cookie: VB-AUTH=...; Domain=localhost can never be stored by a browser on a different domain, so login must happen server-to-server and spotdl-web mints its own session cookie rather than forwarding VB-AUTH to the browser."}, {"id": "plan_00_master_plan_allowlist_authorization_gate", "label": "Email Allowlist Authorization Gate", "file_type": "rationale", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /auth/register is public on vb2007.hu-api, so a successful upstream login only proves the account is real, not that the person may use spotdl-web; ALLOWED_EMAILS is the actual authorization gate, and rejection must be indistinguishable from a wrong password."}, {"id": "plan_00_master_plan_sse_heartbeat_reconnect_pattern", "label": "SSE Heartbeat + Reconnect-Then-Refetch Pattern", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_dedup_disk_reconciliation", "label": "Dedup + Disk Reconciliation", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_worker_dl_concurrency_rationale", "label": "worker-dl Single-Concurrency Rationale", "file_type": "rationale", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "worker-dl deliberately runs --concurrency=1 --prefetch-multiplier=1 because concurrency itself is rate-limit exposure; serialized downloads are safer than throughput."}, {"id": "plan_00_master_plan_downloader_instance_cache", "label": "Cached Downloader Instances (format, bitrate, proxy)", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_pacing_hook", "label": "Pacing Hook (PACING_MIN_SEC/MAX_SEC)", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_spotdl_spotdl_class", "label": "spotdl.Spotdl class", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_spotdl_downloader_class", "label": "spotdl.download.downloader.Downloader class", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_00_master_plan_spotdl_get_simple_songs", "label": "spotdl.utils.search.get_simple_songs", "file_type": "concept", "source_file": "plan/00-master-plan.md", "source_location": null, "source_url": null, "captured_at":